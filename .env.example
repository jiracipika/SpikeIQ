# ------------------------------------------------------------
# Core app URL
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------
# Riot Sign On (RSO)
# ------------------------------------------------------------
# Force deterministic local/demo flow even when credentials are missing.
RIOT_OAUTH_MOCK=true

# Set these only after Riot production approval.
RIOT_CLIENT_ID=YOUR_RIOT_RSO_CLIENT_ID
RIOT_CLIENT_SECRET=YOUR_RIOT_RSO_CLIENT_SECRET

# Must exactly match the callback registered in Riot Developer Portal.
RIOT_REDIRECT_URI=http://localhost:3000/api/riot/callback

# 32-byte base64/base64url key used for AES-256-GCM token encryption at rest.
# Example generation:
#   openssl rand -base64 32
RIOT_TOKEN_ENCRYPTION_KEY=

# Optional (non-production only): allow plaintext token storage if encryption
# key is unset. Set to "false" to enforce encrypted writes in local/staging.
RIOT_ALLOW_PLAINTEXT_TOKENS_IN_DEV=true

# Riot API product key used for server-side VALORANT API routes beyond OAuth
# identity lookups. Never expose to browser/client bundles.
RIOT_API_KEY=

# Maximum number of recent matches fetched per manual sync.
RIOT_SYNC_MATCH_LIMIT=20

# Enables the dev-only Riot ID self-test sync flow (never enabled in production).
RIOT_ENABLE_SELF_TEST=true
