{
  "expo": {
    "name": "SpikeIQ",
    "slug": "spikeiq",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spikeiq.app"
    },
    "android": {
      "package": "com.spikeiq.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
